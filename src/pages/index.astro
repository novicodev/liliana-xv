---
const eventDay = "Sábado";
const eventDate = "24 · 10 · 2026";
const eventTime = "7 pm";
const whatsappMessage = encodeURIComponent(
  "¡Hola! Confirmo mi asistencia a los XV de Liliana Restrepo Macias."
);
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#07152f" />
    <meta name="description" content="Invitación a los XV de Liliana Restrepo Macias" />
    <title>Mis XV · Liliana Restrepo Macias</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=Parisienne&family=Playfair+Display:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main>
      <section class="hero" aria-labelledby="hero-title">
        <div class="stars" aria-hidden="true"></div>
        <div class="hero-wash" aria-hidden="true"></div>
        <div class="moon" aria-hidden="true"></div>
        <div class="golden-frame" aria-hidden="true"></div>
        <div class="hero-content">
          <p class="eyebrow">Una noche bajo las estrellas</p>
          <p class="hero-kicker">Mis XV</p>
          <h1 id="hero-title">Liliana</h1>
          <p class="hero-lastname">Restrepo Macias</p>
          <p class="hero-date">{eventDay} {eventDate} · {eventTime}</p>
          <a class="scroll-cue" href="#celebracion" aria-label="Conocer la invitación">↓</a>
        </div>
      </section>

      <section class="section light" id="celebracion" aria-labelledby="welcome-title" data-reveal>
        <div class="narrow">
          <p class="eyebrow dark">La celebración</p>
          <h2 id="welcome-title">Hay noches que se quedan para siempre</h2>
          <p class="copy">Con mucha ilusión quiero compartir contigo una noche mágica, llena de estrellas, música y momentos que guardaremos en el corazón.</p>
          <p class="signature">Liliana</p>
          <p class="parents">Con el amor de mis padres<br /><strong>Roberto Restrepo y Zuleima Macias</strong></p>
        </div>
      </section>

      <section class="section navy date-section" aria-labelledby="date-title" data-reveal>
        <div class="stars-subtle" aria-hidden="true"></div>
        <div class="narrow">
          <p class="eyebrow">Reserva la fecha</p>
          <p class="date-day">{eventDay}</p>
          <h2 id="date-title">{eventDate}</h2>
          <p class="time">{eventTime}</p>
          <div class="countdown" aria-label="Cuenta regresiva" data-countdown>
            <span class="countdown-block"><strong data-days>0</strong><small>días</small></span>
            <i class="countdown-sep" aria-hidden="true"></i>
            <span class="countdown-block"><strong data-hours>0</strong><small>horas</small></span>
            <i class="countdown-sep" aria-hidden="true"></i>
            <span class="countdown-block"><strong data-minutes>0</strong><small>minutos</small></span>
            <i class="countdown-sep" aria-hidden="true"></i>
            <span class="countdown-block"><strong data-seconds>0</strong><small>segundos</small></span>
          </div>
        </div>
      </section>

      <section class="section light location-section" aria-labelledby="location-title" data-reveal>
        <div class="narrow">
          <p class="eyebrow dark">El lugar</p>
          <h2 id="location-title">Finca el encanto</h2>
          <p class="address">Vereda vanguardia<br />Sector Villa Alejandra casa 1</p>
          <div class="map-placeholder" aria-label="Mapa pendiente de confirmación">
            <span aria-hidden="true">✦</span>
            <p>Mapa próximamente</p>
            <small>La ubicación estará disponible aquí</small>
          </div>
        </div>
      </section>

      <section class="section blue details-section" aria-labelledby="details-title" data-reveal>
        <div class="stars-subtle" aria-hidden="true"></div>
        <div class="narrow">
          <p class="eyebrow">Lo que necesitas saber</p>
          <h2 id="details-title">Detalles</h2>
          <div class="details-grid">
            <article><span class="detail-icon" aria-hidden="true">✧</span><h3>Vestimenta</h3><p>Opcional: mujeres azul celeste</p></article>
            <article><span class="detail-icon" aria-hidden="true">◌</span><h3>Colores reservados</h3><p>Azul noche y dorado</p></article>
            <article><span class="detail-icon" aria-hidden="true">♡</span><h3>Mesa de regalos</h3><p>Lluvia de sobres</p></article>
          </div>
        </div>
      </section>

      <section class="section navy rsvp-section" aria-labelledby="rsvp-title" data-reveal>
        <div class="stars-subtle" aria-hidden="true"></div>
        <div class="narrow">
          <p class="eyebrow">R.S.V.P.</p>
          <h2 id="rsvp-title">Tu presencia es mi mejor regalo</h2>
          <p class="copy">Confirma tu asistencia antes del <strong>18 de octubre</strong>.</p>
          <a class="gold-button" href={`https://wa.me/573025392359?text=${whatsappMessage}`} target="_blank" rel="noopener noreferrer">Confirmar por WhatsApp</a>
          <p class="phone">302 539 2359</p>
        </div>
      </section>

      <section class="section light final-section" aria-labelledby="final-title" data-reveal>
        <div class="narrow">
          <p class="eyebrow dark">Una noche bajo las estrellas</p>
          <h2 id="final-title">Nos vemos en la pista</h2>
          <p class="hashtag">#Mis15Liliana</p>
          <div class="music-card">
            <span class="music-note" aria-hidden="true">♫</span>
            <div><p class="music-label">Música de fondo</p><strong>A Sky Full of Stars</strong><small>Coldplay</small></div>
            <button type="button" class="music-inline-btn" aria-label="Reproducir música" aria-pressed="false">▶</button>
          </div>
          <p class="music-note-copy">La música estará disponible próximamente.</p>
        </div>
      </section>
    </main>

    <footer data-reveal><span>XV</span><p>Liliana Restrepo Macias</p><small>Con cariño, Roberto y Zuleima</small></footer>

    <button class="music-fab" type="button" aria-pressed="false" aria-label="Reproducir música"><span class="music-fab-icon" aria-hidden="true">♪</span><span class="music-fab-label">Música</span></button>
    <audio id="bg-music" preload="none" loop></audio>

    <script>
      // countdown
      const countdown = document.querySelector('[data-countdown]');
      const target = new Date(2026, 9, 24, 19, 0, 0).getTime();
      const pad = (value) => String(value).padStart(2, '0');
      const tick = () => {
        const distance = Math.max(0, target - Date.now());
        const values = {
          days: Math.floor(distance / 86400000),
          hours: Math.floor((distance / 3600000) % 24),
          minutes: Math.floor((distance / 60000) % 60),
          seconds: Math.floor((distance / 1000) % 60),
        };
        Object.entries(values).forEach(([key, value]) => {
          const node = document.querySelector(`[data-${key}]`);
          if (node) node.textContent = key === 'days' ? String(value) : pad(value);
        });
        if (distance === 0 && countdown) countdown.setAttribute('aria-label', 'El gran día ha llegado');
      };
      tick();
      window.setInterval(tick, 1000);

      // reveals suaves — IntersectionObserver
      (() => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const obs = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                obs.unobserve(e.target);
              }
            });
          },
          { threshold: 0.15 }
        );
        document.querySelectorAll('[data-reveal]').forEach((el) => obs.observe(el));
      })();

      // música FAB — toggle decorativo si no hay src, real si hay audio
      (() => {
        const fab = document.querySelector('.music-fab');
        const fabIcon = fab?.querySelector('.music-fab-icon');
        const fabLabel = fab?.querySelector('.music-fab-label');
        const inlineBtn = document.querySelector('.music-inline-btn');
        const audio = document.getElementById('bg-music');
        const hasSrc = !!(audio && audio.currentSrc || audio.getAttribute('src'));
        const setState = (playing) => {
          fab?.setAttribute('aria-pressed', String(playing));
          fab?.setAttribute('aria-label', playing ? 'Pausar música' : 'Reproducir música');
          fab?.classList.toggle('is-playing', playing);
          if (fabIcon) fabIcon.textContent = playing ? '❚❚' : '♪';
          if (fabLabel) fabLabel.textContent = playing ? 'Pausar' : 'Música';
          if (inlineBtn) {
            inlineBtn.setAttribute('aria-pressed', String(playing));
            inlineBtn.setAttribute('aria-label', playing ? 'Pausar música' : 'Reproducir música');
            inlineBtn.textContent = playing ? '❚❚' : '▶';
            inlineBtn.classList.toggle('is-playing', playing);
          }
        };
        const toggle = async () => {
          const isPlaying = fab?.classList.contains('is-playing');
          if (!isPlaying && audio && audio.getAttribute('src')) {
            try { await audio.play(); setState(true); } catch { setState(false); }
          } else if (isPlaying && audio && !audio.paused) {
            audio.pause(); setState(false);
          } else {
            // sin src — toggle visual decorativo
            setState(!isPlaying);
            if (!isPlaying) setTimeout(() => {}, 0);
          }
        };
        fab?.addEventListener('click', toggle);
        inlineBtn?.addEventListener('click', toggle);
        if (audio) {
          audio.addEventListener('ended', () => setState(false));
          audio.addEventListener('pause', () => {
            if (!audio.ended) setState(false);
          });
        }
      })();
    </script>

