          <div class="music-card">
            <span class="music-note" aria-hidden="true">♫</span>
            <div><p class="music-label">Música de fondo</p><strong>A Sky Full of Stars</strong><small>Coldplay</small></div>
            <button type="button" class="music-inline-btn" aria-label="Reproducir música" aria-pressed="false">▶</button>
          </div>
