      .music-fab:hover,.music-fab:focus-visible{background:var(--gold);border-color:var(--gold);color:var(--navy)}
      .music-fab.is-playing{background:var(--gold);border-color:var(--gold);color:var(--navy)}
      .music-fab:focus-visible{outline:2px solid var(--gold);outline-offset:3px}
      .music-fab-icon{font:1rem 'Playfair Display',serif}
      /* 6. reveals suaves */
      [data-reveal]{opacity:0;transform:translateY(14px);transition:opacity .8s ease,transform .8s ease}
      [data-reveal].is-visible{opacity:1;transform:none}
      @keyframes twinkle{0%{opacity:.35;transform:scale(1)}25%{opacity:.90;transform:scale(1.012)}50%{opacity:.48;transform:scale(1)}75%{opacity:.94;transform:scale(1.018)}100%{opacity:.52;transform:scale(1.004)}}@keyframes twinkle2{0%{opacity:.35;transform:scale(1)}30%{opacity:.72;transform:scale(1.01)}60%{opacity:.38;transform:scale(1)}100%{opacity:.58;transform:scale(1.008)}}@keyframes twinkle-subtle{0%{opacity:.38;transform:scale(1)}30%{opacity:.88;transform:scale(1.01)}60%{opacity:.42;transform:scale(1)}100%{opacity:.82;transform:scale(1.008)}}@keyframes random-twinkle{0%{opacity:.08;transform:scale(.65)}45%{opacity:var(--peak);transform:scale(1.35)}100%{opacity:.12;transform:scale(.8)}}@keyframes shooting{0%{opacity:0;transform:translateX(0) translateY(0) rotate(18deg)}6%{opacity:.95}12%{opacity:0;transform:translateX(118vw) translateY(18vh) rotate(18deg)}100%{opacity:0;transform:translateX(118vw) translateY(18vh) rotate(18deg)}}:focus-visible{outline:2px solid var(--gold);outline-offset:4px}@media(max-width:700px){.hero-content{padding:15vh 24px 6vh}.hero-kicker{margin-bottom:1.35rem}.hero h1{line-height:1.05;padding:.10em 0 .06em;margin-top:.45rem}.hero-lastname{margin-top:0}.hero-lastname{margin-top:0}.moon{top:8%;right:8%;width:78px}.moon-secondary{top:72%;left:6%;width:32px;opacity:.26}.moon-deco--location{top:12%;right:5%;width:26px;height:26px}.moon-deco--final{bottom:12%;left:5%;width:22px;height:22px}.constellation-deco{top:8%;left:4%;opacity:.08}.hero-date{margin-top:5rem}.section{padding-block:5.5rem}.details-grid{grid-template-columns:1fr;gap:12px}.details-grid article{min-height:auto;padding:20px;box-shadow:8px 8px 0 #173654;transform:none}.countdown{gap:clamp(8px,2.5vw,14px)}.countdown strong{font-size:clamp(1.35rem,8vw,2.3rem)}.countdown small{font-size:.52rem;letter-spacing:.04em}.countdown-sep{height:clamp(1rem,5vw,1.4rem)}.location-map{aspect-ratio:.82}.music-card{transform:none;box-shadow:6px 6px 0 #ddd8c8}.golden-frame{inset:.45rem}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.stars,.stars-twinkle-2,.stars-subtle,.stars-subtle-light,.shooting-star{animation:none;opacity:.5}.shooting-star{opacity:0}.random-stars{display:none}.hero h1{animation:none}[data-reveal]{opacity:1;transform:none;transition:none}[data-reveal].is-visible{opacity:1;transform:none}}
