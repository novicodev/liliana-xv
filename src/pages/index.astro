      .detail-icon{display:block;color:var(--gold);font-size:2rem}.details-grid h3{margin:16px 0 10px;font-family:'Playfair Display',serif;font-size:1.25rem;font-weight:400}.details-grid p{margin:0;color:#d5e1ef;font-size:.9rem;line-height:1.6}.rsvp-section{text-align:center}.rsvp-section .copy{margin:0 auto 2rem}.gold-button{display:inline-block;min-height:48px;padding:15px 24px;background:var(--gold);color:var(--navy);font-size:.75rem;font-weight:500;letter-spacing:.1em;text-decoration:none;text-transform:uppercase}.gold-button:hover{background:#f2d98d}.phone{margin-top:20px;color:var(--ice);letter-spacing:.1em}.final-section{text-align:center}.hashtag{color:#866819;font-family:'Playfair Display',serif;font-size:1.6rem;font-style:italic}
