      .location-section{text-align:center}.address{font-family:'Playfair Display',serif;font-size:1.25rem;line-height:1.7}
      .location-map{position:relative;z-index:1;margin:2.2rem auto 0;max-width:520px;aspect-ratio:1.32;overflow:hidden;border:1px solid color-mix(in srgb, var(--gold) 22%, var(--line));background:var(--cream)}
      .location-map iframe{width:100%;height:100%;border:0;display:block;filter:saturate(.96) contrast(1.02)}
      .location-section .text-link{position:relative;z-index:1;display:inline-flex;align-items:center;gap:.35em;margin-top:1.15rem;color:#866819;font-size:.78rem;font-weight:500;letter-spacing:.08em;text-transform:uppercase;text-decoration:none;border-bottom:1px solid color-mix(in srgb, var(--gold) 55%, transparent)}
