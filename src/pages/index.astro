      @keyframes name-shine{0%,100%{background-position:0% 50%}50%{background-position:100% 50%}}
      h2{margin:18px 0 22px;font-size:clamp(2.6rem,6vw,4.5rem);line-height:1}.hero-lastname{margin:0 0 0;color:var(--ice);font-family:'Playfair Display',serif;font-size:clamp(1rem,1.8vw,1.22rem);font-style:italic;letter-spacing:.28em;text-shadow:0 2px 12px rgba(4,13,32,.78)}.hero-lastname::after{content:'';display:block;width:clamp(54px,11vw,92px);height:1px;margin:14px auto 0;background:linear-gradient(90deg,transparent,var(--gold),transparent);opacity:.85;box-shadow:0 0 8px rgba(216,184,98,.42)}.hero-date{margin:7rem 0 0;color:var(--ice);font-size:.78rem;letter-spacing:.2em;text-transform:uppercase;text-shadow:0 2px 12px rgba(4,13,32,.78)}.scroll-cue{display:block;margin:2.5rem auto 0;width:48px;height:48px;border:1px solid #e3c36d88;border-radius:50%;font-size:1.4rem;line-height:44px;text-decoration:none}.section{padding:clamp(5rem,12vw,10rem) 24px}.narrow{max-width:760px;margin:0 auto}.light{background:var(--cream);color:var(--ink)}.navy{background:var(--navy);color:var(--cream)}.blue{background:var(--blue);color:var(--cream)}.dark{color:#9e7b22}.copy{max-width:620px;font-size:clamp(1rem,2vw,1.15rem);line-height:1.75}.signature{margin:40px 0 4px;color:#866819;font-family:'Parisienne',cursive;font-size:3rem}.parents{line-height:1.7}.parents strong{font-family:'Playfair Display',serif;font-size:1.1rem;font-weight:400}.date-section{text-align:center}.date-day{margin:0 0 .4rem;color:var(--gold);font-family:'Playfair Display',serif;font-size:clamp(1.15rem,3vw,1.35rem);font-style:italic;letter-spacing:.12em;text-transform:uppercase;display:block;opacity:.95}.time{color:var(--ice);font-family:'Playfair Display',serif;font-size:1.5rem;font-style:italic}
