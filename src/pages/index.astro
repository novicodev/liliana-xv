          </div>
          <a class="text-link" href="https://maps.app.goo.gl/E4W9nB8u8osL38Mv8" target="_blank" rel="noreferrer">Cómo llegar <span aria-hidden="true">↗</span></a>
        </div>
      </section>

      <section class="section blue details-section" aria-labelledby="details-title" data-reveal>
