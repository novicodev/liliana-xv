      .golden-frame{position:absolute;inset:clamp(0.5rem,1.8vw,1rem);pointer-events:none;z-index:0;border:1px solid color-mix(in srgb, var(--gold) 85%, transparent)}
      .golden-frame::before,.golden-frame::after{content:'';position:absolute;width:clamp(28px,6vw,54px);height:clamp(28px,6vw,54px);border-color:var(--gold);border-style:solid}
      .golden-frame::before{top:-1px;left:-1px;border-width:1.5px 0 0 1.5px}
      .golden-frame::after{bottom:-1px;right:-1px;border-width:0 1.5px 1.5px 0}
      .hero-content{position:relative;z-index:1;padding:18vh 24px 8vh;text-align:center;overflow:visible}.hero-content::before{content:'';position:absolute;z-index:-1;inset:16% -12% 8%;background:radial-gradient(ellipse at center,rgba(10,28,56,.42) 0%,rgba(10,28,56,.16) 45%,transparent 74%);filter:blur(18px);pointer-events:none}.eyebrow{margin:0;color:var(--gold);font-size:.72rem;font-weight:500;letter-spacing:.24em;text-transform:uppercase}.hero .eyebrow{margin:1.2rem 0 2.4rem;text-shadow:0 2px 12px rgba(4,13,32,.72)}.hero-kicker{font-family:'Playfair Display',serif;font-size:clamp(1.6rem,4.5vw,2.6rem);font-style:italic;color:var(--cream);margin:0 0 2.2rem;letter-spacing:.14em;text-transform:uppercase;font-weight:400;opacity:.95;text-shadow:0 2px 14px rgba(4,13,32,.78)}h2{font-family:'Playfair Display',serif;font-weight:400;letter-spacing:-.035em}
