      .moon{position:absolute;top:12%;right:14%;width:clamp(84px,14vw,160px);aspect-ratio:1;border-radius:50%;z-index:0;pointer-events:none;background:radial-gradient(circle at 30% 30%,#fffef0 0%,#fff8d8 45%,#f0e6b8 70%,#e8d9a0 100%);box-shadow:0 0 40px #fff4b855,0 0 80px #fff4b822,inset -8px -4px 12px rgba(0,0,0,.08);overflow:hidden;outline:1px solid #e3c36d55;outline-offset:6px}
      .moon::before{content:'';position:absolute;width:28%;height:28%;left:22%;top:28%;background:radial-gradient(circle,#e8dcc0 0%,#d4c9a8 60%,transparent 70%);border-radius:50%;opacity:.5;box-shadow:inset 2px 2px 4px rgba(0,0,0,.15)}
      .moon::after{content:'';position:absolute;width:18%;height:18%;left:58%;top:55%;background:radial-gradient(circle,#e8dcc0 0%,#d4c9a8 62%,transparent 72%);border-radius:50%;opacity:.4;box-shadow:inset 1.5px 1.5px 3px rgba(0,0,0,.12)}
      .moon-secondary{position:absolute;top:68%;left:8%;width:42px;height:42px;border-radius:50%;z-index:0;pointer-events:none;opacity:.32;background:radial-gradient(circle at 32% 32%,#fff8d8 0%,#f0e6b8 55%,#e0cf90 100%);box-shadow:0 0 18px #fff4b844,0 0 36px #fff4b822;outline:1px solid #e3c36d44;outline-offset:4px}
