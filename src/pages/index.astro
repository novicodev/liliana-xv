      .shooting-star--1{top:18%;left:-10%;transform:rotate(18deg);animation:shooting 9s ease-in infinite}
      .shooting-star--2{top:42%;left:-10%;transform:rotate(18deg);animation:shooting 12s ease-in infinite;animation-delay:4.2s}
