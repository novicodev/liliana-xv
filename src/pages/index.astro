    <footer data-reveal style="position:relative; overflow:hidden;"><div class="stars-subtle" aria-hidden="true"></div><div class="moon-deco moon-deco--footer" aria-hidden="true"></div><span>XV</span><p>Liliana Restrepo Macias</p><small>Con cariño, Roberto y Zuleima</small></footer>

    <button class="music-fab" type="button" aria-pressed="false" aria-label="Reproducir música"><span class="music-fab-icon" aria-hidden="true">♪</span><span class="music-fab-label">Música</span></button>
    <audio id="bg-music" preload="metadata" loop src="/a-sky-full-of-stars.mp3"></audio>

    <script>
      // countdown
      const countdown = document.querySelector('[data-countdown]');
      const target = new Date(2026, 9, 24, 19, 0, 0).getTime();
      const pad = (value) => String(value).padStart(2, '0');
      const tick = () => {
        const distance = Math.max(0, target - Date.now());
        const values = {
          days: Math.floor(distance / 86400000),
          hours: Math.floor((distance / 3600000) % 24),
          minutes: Math.floor((distance / 60000) % 60),
          seconds: Math.floor((distance / 1000) % 60),
        };
        Object.entries(values).forEach(([key, value]) => {
          const node = document.querySelector(`[data-${key}]`);
          if (node) node.textContent = key === 'days' ? String(value) : pad(value);
        });
        if (distance === 0 && countdown) countdown.setAttribute('aria-label', 'El gran día ha llegado');
      };
      tick();
      window.setInterval(tick, 1000);

      // estrellas independientes — cada una titila con ritmo y retraso propios
      (() => {
        const field = document.querySelector('.random-stars');
        if (!field || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const count = 34;
        for (let index = 0; index < count; index += 1) {
          const star = document.createElement('span');
          star.className = 'random-star';
          star.style.setProperty('--x', `${Math.random() * 100}%`);
          star.style.setProperty('--y', `${Math.random() * 100}%`);
          star.style.setProperty('--size', `${Math.random() * 2.2 + 1}px`);
          star.style.setProperty('--duration', `${Math.random() * 3.5 + 2.8}s`);
          star.style.setProperty('--delay', `${Math.random() * -6}s`);
          star.style.setProperty('--peak', `${Math.random() * 0.55 + 0.35}`);
          field.appendChild(star);
        }
      })();

      // reveals suaves — IntersectionObserver
      (() => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          document.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('is-visible'));
          return;
        }
        const obs = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                obs.unobserve(e.target);
              }
            });
          },
          { threshold: 0.15 }
        );
        document.querySelectorAll('[data-reveal]').forEach((el) => obs.observe(el));
      })();

      // música FAB — toggle decorativo si no hay src, real si hay audio
      (() => {
        const fab = document.querySelector('.music-fab');
        const fabIcon = fab?.querySelector('.music-fab-icon');
        const fabLabel = fab?.querySelector('.music-fab-label');
        const inlineBtn = document.querySelector('.music-inline-btn');
        const audio = document.getElementById('bg-music');
        const hasSrc = !!(audio && audio.currentSrc || audio.getAttribute('src'));
        const setState = (playing) => {
          fab?.setAttribute('aria-pressed', String(playing));
          fab?.setAttribute('aria-label', playing ? 'Pausar música' : 'Reproducir música');
          fab?.classList.toggle('is-playing', playing);
          if (fabIcon) fabIcon.textContent = playing ? '❚❚' : '♪';
          if (fabLabel) fabLabel.textContent = playing ? 'Pausar' : 'Música';
          if (inlineBtn) {
            inlineBtn.setAttribute('aria-pressed', String(playing));
            inlineBtn.setAttribute('aria-label', playing ? 'Pausar música' : 'Reproducir música');
            inlineBtn.textContent = playing ? '❚❚' : '▶';
            inlineBtn.classList.toggle('is-playing', playing);
          }
        };
        const toggle = async () => {
          const isPlaying = fab?.classList.contains('is-playing');
          if (!isPlaying && audio && audio.getAttribute('src')) {
            try { await audio.play(); setState(true); } catch { setState(false); }
          } else if (isPlaying && audio && !audio.paused) {
            audio.pause(); setState(false);
          } else {
            // sin src — toggle visual decorativo
            setState(!isPlaying);
            if (!isPlaying) setTimeout(() => {}, 0);
          }
        };
        fab?.addEventListener('click', toggle);
        inlineBtn?.addEventListener('click', toggle);
        if (audio) {
          audio.addEventListener('ended', () => setState(false));
          audio.addEventListener('pause', () => {
            if (!audio.ended) setState(false);
          });
        }
      })();
    </script>

