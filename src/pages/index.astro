      .music-card button.is-playing{background:var(--gold);border-color:var(--gold);color:var(--navy)}
      .music-note-copy{color:#817c70;font-size:.75rem}footer{position:relative;overflow:hidden;padding:64px 24px;text-align:center;background:#0b1a34}footer .stars-subtle{opacity:.30}footer .moon-deco--footer{pointer-events:none}footer span,footer p,footer small{position:relative;z-index:1}footer span{display:block;color:var(--gold);font-family:'Playfair Display',serif;font-size:3rem}footer p{margin:10px 0;color:#dce7f5;font-family:'Playfair Display',serif;font-style:italic}footer small{color:#91a8c8}
