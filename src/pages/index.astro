      .map-placeholder span{color:#b39236;font-size:2rem}.map-placeholder p{margin:12px 0 4px;font-family:'Playfair Display',serif;font-size:1.4rem}.map-placeholder small{color:#6f6a60}.details-section{text-align:center}.details-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:3.5rem}
      .details-grid article{min-height:190px;padding:24px 16px;border:1px solid #a9d9f244;background:#12305a;box-shadow:10px 10px 0 #0a1c38}
      .detail-icon{display:block;color:var(--gold);font-size:2rem}.details-grid h3{margin:16px 0 10px;font-family:'Playfair Display',serif;font-size:1.25rem;font-weight:400}.details-grid p{margin:0;color:#d5e1ef;font-size:.9rem;line-height:1.6}.rsvp-section{text-align:center}.rsvp-section .copy{margin:0 auto 2rem}.gold-button{display:inline-block;min-height:48px;padding:15px 24px;background:var(--gold);color:var(--navy);font-size:.75rem;font-weight:500;letter-spacing:.1em;text-decoration:none;text-transform:uppercase}.gold-button:hover{background:#f2d98d}.phone{margin-top:20px;color:var(--ice);letter-spacing:.1em}.final-section{text-align:center}.hashtag{color:#866819;font-family:'Playfair Display',serif;font-size:1.6rem;font-style:italic}
      .music-card{display:flex;align-items:center;gap:18px;max-width:520px;margin:3.5rem auto 0;padding:20px;text-align:left;border:1px solid #d6cda9;background:#eee9dc;box-shadow:8px 8px 0 #ddd8c8;transform:rotate(-.3deg)}
      .music-note{color:#b39236;font-size:2rem}.music-card div{display:grid;gap:3px;flex:1}.music-label,.music-card small{margin:0;color:#777165;font-size:.7rem;letter-spacing:.1em;text-transform:uppercase}.music-card strong{font-family:'Playfair Display',serif;font-size:1.1rem;font-weight:400}
      .music-card button{width:44px;height:44px;border:1px solid #aaa397;border-radius:50%;background:transparent;color:#817c70;cursor:pointer;transition:background .2s,color .2s,border-color .2s}
      .music-card button:hover,.music-card button:focus-visible{background:var(--gold);border-color:var(--gold);color:var(--navy)}
      .music-card button.is-playing{background:var(--gold);border-color:var(--gold);color:var(--navy)}
      .music-note-copy{color:#817c70;font-size:.75rem}footer{padding:64px 24px;text-align:center;background:#040d20}footer span{display:block;color:var(--gold);font-family:'Playfair Display',serif;font-size:3rem}footer p{margin:10px 0;color:#dce7f5;font-family:'Playfair Display',serif;font-style:italic}footer small{color:#91a8c8}
      /* 7. música FAB */
      .music-fab{position:fixed;right:1rem;bottom:1rem;z-index:20;display:flex;align-items:center;gap:.5rem;padding:.65rem .9rem;border:1px solid var(--gold);border-radius:999px;background:rgba(255,253,251,.92);color:var(--ink);font:500 .75rem 'DM Sans',sans-serif;letter-spacing:.08em;cursor:pointer;box-shadow:0 8px 20px rgba(7,21,47,.18);transition:background .2s,color .2s,border-color .2s}
      .music-fab:hover,.music-fab:focus-visible{background:var(--gold);border-color:var(--gold);color:var(--navy)}
      .music-fab.is-playing{background:var(--gold);border-color:var(--gold);color:var(--navy)}
      .music-fab:focus-visible{outline:2px solid var(--gold);outline-offset:3px}
      .music-fab-icon{font:1rem 'Playfair Display',serif}
      /* 6. reveals suaves */
      [data-reveal]{opacity:0;transform:translateY(14px);transition:opacity .8s ease,transform .8s ease}
      [data-reveal].is-visible{opacity:1;transform:none}
      @keyframes twinkle{from{opacity:.45;transform:scale(1)}to{opacity:.9;transform:scale(1.015)}}:focus-visible{outline:2px solid var(--gold);outline-offset:4px}@media(max-width:700px){.hero-content{padding:15vh 24px 6vh}.hero-kicker{margin-bottom:1.35rem}.hero h1{line-height:1.05;padding:.10em 0 .16em;margin-top:.45rem}.moon{top:8%;right:8%;width:78px}.hero-date{margin-top:5rem}.section{padding-block:5.5rem}.details-grid{grid-template-columns:1fr;gap:12px}.details-grid article{min-height:auto;padding:20px;box-shadow:8px 8px 0 #0a1c38;transform:none}.countdown{gap:clamp(8px,2.5vw,14px)}.countdown strong{font-size:clamp(1.35rem,8vw,2.3rem)}.countdown small{font-size:.52rem;letter-spacing:.04em}.countdown-sep{height:clamp(1rem,5vw,1.4rem)}.map-placeholder{transform:none;box-shadow:6px 6px 0 #eee6d4}.music-card{transform:none;box-shadow:6px 6px 0 #ddd8c8}.golden-frame{inset:.45rem}}@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}.stars,.stars-subtle{animation:none}.hero h1{animation:none}[data-reveal]{opacity:1;transform:none;transition:none}[data-reveal].is-visible{opacity:1;transform:none}}
    </style>
  </body>
</html>
